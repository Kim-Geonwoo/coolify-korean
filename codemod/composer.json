{
    "name": "coolify-ko/codemod",
    "description": "Coolify Blade·Livewire 하드코딩 영어를 Laravel 번역 호출로 바꾸고 문구 카탈로그를 만든다",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "laravel/framework": "12.69.3",
        "nikic/php-parser": "^5.4",
        "stillat/blade-parser": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CoolifyKo\\Codemod\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolifyKo\\Codemod\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/codemod"],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
