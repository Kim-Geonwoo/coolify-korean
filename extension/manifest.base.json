{
  "manifest_version": 3,
  "name": "Coolify 한국어 (비공식)",
  "short_name": "Coolify 한국어",
  "version": "0.1.3",
  "description": "Coolify 대시보드 화면 글자를 한국어로 바꾸는 비공식 확장입니다. 사용자가 켠 주소에서만 동작하며, 화면 글이나 개인 정보를 밖으로 보내지 않습니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Coolify 한국어",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
