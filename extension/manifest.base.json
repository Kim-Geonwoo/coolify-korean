{
  "manifest_version": 3,
  "name": "Coolify 한국어 (비공식)",
  "short_name": "Coolify 한국어",
  "version": "0.1.4",
  "description": "Coolify 대시보드 화면을 한국어로 변환해 주는 비공식 확장 프로그램입니다. 사용자가 지정한 주소에서만 동작하며, 화면 텍스트나 개인정보를 외부로 전송하지 않습니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Coolify 한국어",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
